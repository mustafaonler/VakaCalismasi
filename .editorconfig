root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,props,csproj,slnx,xml}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
# Test method names use underscores (Given_When_Then style)
dotnet_diagnostic.CA1707.severity = none

# EF Core migrations are generated code
[**/Migrations/*.cs]
generated_code = true
